# MongoDB (local for development, Atlas URI for production — no code changes needed)
# MONGODB_URI=mongodb://127.0.0.1:27017/asha-marble
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Image storage: "local" saves uploads under public/uploads (no Cloudinary account needed).
# Switch to "cloudinary" once the three CLOUDINARY_* values below are filled in — no code changes required.
IMAGE_STORAGE_PROVIDER=cloudinary

# Cloudinary (only required when IMAGE_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Public base URL of the site
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Live domain used for canonical URLs, sitemap and structured data (SEO)
NEXT_PUBLIC_SITE_URL=https://ashamarble.com

# Default admin account (seeded automatically on startup if it doesn't exist)
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me
